{
  "name": "space-view",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "@watsonserve/*"
  ],
  "scripts": {
    "utils": "pnpm --filter @watsonserve/asm run build && pnpm --filter @watsonserve/utils build",
    "audio": "pnpm --filter @watsonserve/audioplayer build",
    "ui": "pnpm --filter @watsonserve/ui build",
    "connector": "pnpm --filter @watsonserve/connector build",
    "web": "pnpm run --filter @watsonserve/web build",
    "resources": "pnpm run --filter @watsonserve/resources build",
    "elec": "pnpm run --filter @watsonserve/electron build",
    "build": "pnpm utils && pnpm audio && pnpm web && pnpm elec",
    "package": "pnpm build && ./pack.sh",
    "buildweb": "pnpm web && rm -rf ./dist/views && mv ./@watsonserve/web/build ./dist/views",
    "webdev": "pnpm run --filter @watsonserve/web start",
    "dev": "pnpm run --filter @watsonserve/electron dev",
    "resource": "pnpm run --filter @watsonserve/resources build",
    "stock": "pnpm run --filter @watsonserve/stock start",
    "build_stock": "pnpm run --filter @watsonserve/stock build"
  },
  "devDependencies": {
    "@rsbuild/plugin-svgr": "^1.2.2",
    "@types/node": "^25.8.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "packageManager": "pnpm@11.17.0"
}
