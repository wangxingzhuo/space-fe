.settings
  margin 16px
  border-radius 8px
  padding 16px
  max-width 420px
  background rgba(255, 255, 255, 0.25)

.title
  margin-bottom 12px

.form
  display flex
  flex-direction column
  gap 12px

.line
  display flex
  flex-direction column
  gap 4px

.label
  font-size 14px

.select
  border 0
  border-radius var(--radius)
  padding 4px 8px
  height 32px
  color #fff
  font-size 16px
  background-color var(--form-bg-color)

  option
    color #111

.result
  margin-top 8px
  font-size 13px
