.tips {
  margin-top: -80px;
  border-radius: 4px;
  padding: 20px;
  min-width: 280px;
  color: #ddd;
  background: var(--primary-bg-color);
}

.tips-category {
  margin-bottom: 8px;
  color: #fff;
}

.tips-detail {
  margin-bottom: 8px;
}

.tips-holiday {
  font-size: 13px;
}

.tips-table {
  width: 100%;
}

.tips-date, .tips-code {
  text-align: left;
  white-space: nowrap;
}

.tips-amount {
  text-align: right;
  white-space: nowrap;
}
